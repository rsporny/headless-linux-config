#!/bin/sh
# git-credential-org — supply a GitHub PAT chosen by the org in the request path.
# Reads ~/.local/share/gh-tokens/pat-<org>. No file, no credential: git fails closed.

[ "$1" = "get" ] || exit 0

host=; path=
while IFS='=' read -r key value; do
    [ -n "$key" ] || break
    case "$key" in
        host) host=$value ;;
        path) path=$value ;;
    esac
done

[ "$host" = "github.com" ] || exit 0

org=${path%%/*}
case "$org" in
    ''|*[!A-Za-z0-9._-]*) exit 0 ;;
esac

token_file="$HOME/.local/share/gh-tokens/pat-$org"
[ -r "$token_file" ] || exit 0

echo "username=x-access-token"
echo "password=$(cat "$token_file")"
